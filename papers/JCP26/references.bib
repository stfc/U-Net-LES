	keywords = {Computer Science - Machine Learning, Statistics - Machine Learning},
	file = {PDF:D\:\\Jony\\Work\\STFC\\literature\\Zotero\\storage\\FL3G5MAI\\Kingma and Welling - 2022 - Auto-Encoding Variational Bayes.pdf:application/pdf},
}

@misc{ho_denoising_2020,
