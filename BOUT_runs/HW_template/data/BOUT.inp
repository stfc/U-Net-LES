#
# Hasegawa-Wakatani test case
#

timestep = 1   # Output timestep
nout = 1000      # Number of output steps

MYG = 0  # No need for Y communications

periodicX = true  # Domain is periodic in X

[mesh]
Lx = 50.176
Ly = 1.0
Lz = 50.176

nx = 68  # Note 4 guard cells in X
ny = 1 
nz = 64  # Periodic, so no guard cells in Z

dx = Lx/(nx-4)
dy = Ly/ny 
dz = Lz/nz


[solver]
mxstep = 1e7

[output]
enabled = true 

[hw]
alpha = 1.0    # Adiabaticity (~ conductivity)
kappa = 0.5    # Density gradient drive
Dvort = 1.e-3   # Vorticity diffusion
Dn = 1.e-3   # Density diffusion

# les_cd = 1.96e-3  # Mode 4 hyperviscosity;
# les_cd = 5.35e-2  # Mode 5 Smagorinski
# les_cd = 1.10e-4    # Mode 6 CENTORI

modified = false

bracket = 2  # 0 = std, 1 = simple, 2 = arakawa

[all]
scale = 0.0

bndry_all = dirichlet_o2

[vort]
scale = 0.1  # Fluctuation amplitude
function = mixmode(2*pi*x) * mixmode(z) # Fluctuation function


[unet]
# U-Net settings are read only from this section (not environment variables).
# Commented entries retain Python/checkpoint defaults.
# Relative paths are relative to the run working directory, not this input file.

# These are the most common flags
dns_init = 0  # -1=fresh DNS,
              #  0=filtered LES,
              #  1=filtered DNS,
              #  2=DNS from fields,
              #  3=DNS replay,
              #  4=hyperviscosity,
              #  5=Smagorinsky,
              #  6=CENTORI, 
              #  7=pure implicit LES
write_diagnostics = 2  # 0=off, 1=all, 2=fields only
checkpoint = ../../training/training_HW_dns256_les32/checkpoints/best.pt
dns_path = ../../fields/fields_HW_run0_time501_N256.npz

# implicit = true  # true: subgrid correction; false: full DNS brackets (C++ and Python)
# profile = false  # Print C++ convective/diffusive timing
# rescaling = 0  # 0=off, 2=formula 13, 3=initial DNS maxima
# reconstruct_channels = none  # Mode 1: none, all, or comma-separated channel names
# write_arakawa_terms = false  # Save C++ bracket diagnostics through Python
# dns_field_dir = results_U-Net_DNS/fields  # Mode 3 replay directory
# device = cpu  # cpu or cuda; omitted selects automatically
# site_packages = /path/to/matching/python/site-packages
# alpha = 0.25  # Germano filter width, distinct from [hw] alpha
# omega_from_potential = true
# laplacian_order = 2  # 2 or 4
# inverse_method = exact  # exact or van_cittert
# inverse_filter = cutoff  # cutoff or filtered_dns_spectrum
# inverse_cutoff_fraction = none
# inverse_cutoff_order = 8
# inverse_min_wavenumber = 2.0
# van_cittert_iterations = 1
# van_cittert_relaxation = 1.0
# post_filter = none  # none, high_order, or gaussian
# post_cutoff_fraction = none  # none, auto, or a numeric fraction
# post_cutoff_order = 8
# The callback uses the active BOUT++ input file automatically.
